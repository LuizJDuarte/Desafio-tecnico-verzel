# Copie para ".env" (na raiz do repositório) e ajuste o que precisar.
# A API carrega este arquivo sozinha em desenvolvimento. Variáveis já definidas no ambiente têm prioridade.
# Todos os valores abaixo são os padrões de desenvolvimento: sem .env a aplicação sobe do mesmo jeito.

# ---- Servidor ----
NODE_ENV=development
PORT=3000

# ---- Banco de dados (PostgreSQL) ----
# Padrão compatível com "docker compose up -d db".
# No Neon, use a connection string do painel (ela já vem com ?sslmode=require).
DATABASE_URL=postgres://arremate:arremate@localhost:5432/arremate
# auto: segue o sslmode da URL | true: força SSL | false: desliga SSL
DATABASE_SSL=auto
DATABASE_POOL_MAX=10

# ---- Segredos (obrigatórios em produção, mínimo de 16 caracteres) ----
# Gere valores aleatórios, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# JWT_SECRET assina o cookie de sessão. Trocar desconecta todo mundo.
JWT_SECRET=
# AUDIT_SIGNING_SECRET deriva a chave Ed25519 que assina o histórico de lances. NUNCA troque depois
# que houver lances: as assinaturas antigas deixam de conferir e a auditoria passa a acusar adulteração.
AUDIT_SIGNING_SECRET=
# PSEUDONYM_SECRET gera os pseudônimos dos licitantes. Mesma regra: não troque depois de haver lances.
PSEUDONYM_SECRET=
JWT_EXPIRES_IN_HOURS=168

# ---- Cookies, proxy e CORS ----
# Em produção o padrão é true (cookie só trafega por HTTPS). Use false em http://localhost.
# COOKIE_SECURE=false
# Em produção o padrão é true (o Render fica atrás de um proxy reverso).
# TRUST_PROXY=false
# Só é necessário se o front for servido de OUTRA origem (por padrão a API serve o front na mesma origem).
ALLOWED_ORIGINS=

# ---- Dados de demonstração ----
# true: na inicialização, se o banco estiver vazio, cria 1 leiloeiro, 2 licitantes e lotes em todos os estados.
# (padrão sem .env: false)
SEED_DEMO_DATA=true

# ---- API externa (Art Institute of Chicago) ----
# artic: API real | fake: catálogo local com as mesmas obras (útil offline e nos testes)
CATALOG_PROVIDER=artic
ARTIC_API_URL=https://api.artic.edu/api/v1
# Contato opcional enviado no cabeçalho AIC-User-Agent, como pede a documentação do museu
# (por exemplo, a URL do seu repositório).
ARTIC_CONTACT=
CATALOG_TIMEOUT_MS=6000
# true: guarda no banco uma cópia da imagem de cada lote (o lote continua com imagem se o museu cair)
IMAGE_DOWNLOAD_ENABLED=true

# ---- Regras do leilão ----
# "Lance aceito nos últimos 2 minutos estende o fim do lote para +2 minutos."
ANTI_SNIPING_WINDOW_SECONDS=120
ANTI_SNIPING_EXTENSION_SECONDS=120

# ---- Diversos ----
SCHEDULER_ENABLED=true
RATE_LIMIT_ENABLED=true
SWAGGER_ENABLED=true
# WEB_DIST_PATH=apps/web/dist

# ---- Testes ----
# DATABASE_URL_TEST=postgres://arremate:arremate@localhost:5432/arremate_test
# E2E_DATABASE_URL=postgres://arremate:arremate@localhost:5432/arremate_e2e
# E2E_PORT=3100
